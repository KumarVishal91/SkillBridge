FROM node:20-alpine AS build
WORKDIR /app
COPY client/package*.json ./
RUN npm install
COPY client/ .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
RUN printf 'server {\n  listen 80;\n  location / { root /usr/share/nginx/html; try_files $uri /index.html; }\n  location /api/ { proxy_pass http://backend:5000; }\n  location /socket.io/ { proxy_pass http://backend:5000; proxy_http_version 1.1; proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade"; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
